{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hanpeng-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  // OpenNext runs Next.js on the Workers Node.js compatibility layer.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Makes console.log (incl. the /api/event analytics beacon) show up under
  // Workers → Logs and in `wrangler tail`.
  "observability": {
    "enabled": true
  },
  // An approximate 5 requests / minute / Cloudflare location per client IP.
  // Pair with Turnstile and provider-side account spend limits.
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "vars": {
    "OPENROUTER_MODEL": "openai/gpt-4.1-mini"
  }
}
