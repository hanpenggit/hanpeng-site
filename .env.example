# For `npm run dev`, copy to `.env.local`, fill in genuine values locally.
# For production set OPENROUTER_API_KEY and TURNSTILE_SECRET_KEY as
# Cloudflare Worker SECRETS, not GitHub variables and not wrangler.jsonc vars.
# GitHub Actions build MUST have NEXT_PUBLIC_TURNSTILE_SITE_KEY as a GitHub
# Actions repository variable. This is a PUBLIC key and safe to bundle.
# Never commit this file after adding actual credentials!

OPENROUTER_API_KEY=replace-with-your-own-server-side-key
# See https://openrouter.ai/openai/gpt-4.1-mini
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Created at Cloudflare Dashboard > Turnstile > Add widget
# PUBLIC client key; required at BUILD TIME with the Github deploy workflow.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-public-site-key
# PRIVATE secret; Cloudflare Worker Secrets only in production.
TURNSTILE_SECRET_KEY=replace-with-private-secret

# Optional STRICT worldwide sliding-window limit (10 requests / IP / 5min).
# Without these, the Cloudflare-native per-PoP rate-limit binding is used.
# For `next dev` outside Workers, configure both to test live AI calls.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional old ingestion utility credentials; NOT connected to public chat.
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# For production, match https://my.hanpeng.xyz exactly.
NEXT_PUBLIC_SITE_URL=https://my.hanpeng.xyz
NEXT_PUBLIC_CF_BEACON_TOKEN=
