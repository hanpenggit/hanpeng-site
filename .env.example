# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in real values. NEVER commit .env.local.
# Only NEXT_PUBLIC_* values reach the browser; everything else is server-only.
#
# In production these live in Cloudflare instead:
#   npx wrangler secret put OPENROUTER_API_KEY
#   npx wrangler secret put UPSTASH_REDIS_REST_URL
#   npx wrangler secret put UPSTASH_REDIS_REST_TOKEN
#   npx wrangler secret put UPSTASH_VECTOR_REST_URL
#   npx wrangler secret put UPSTASH_VECTOR_REST_TOKEN
# Build-time (public) values go in wrangler.jsonc → vars, or in GitHub Actions
# variables if you deploy from CI.
# ─────────────────────────────────────────────────────────────────────────────

# OpenRouter — one key, any model. Powers the "问问 韩鹏" chatbot.
# Get a key at https://openrouter.ai/keys  (server-only, never NEXT_PUBLIC_)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Pick any current slug from https://openrouter.ai/models
# Defaults in code to anthropic/claude-3.5-haiku if unset.
OPENROUTER_MODEL=anthropic/claude-3.5-haiku

# Upstash Redis — per-IP rate limiting for the chatbot (free tier: https://upstash.com).
# If these are absent the limiter no-ops (fine for local dev; REQUIRED in production).
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# Upstash Vector — RAG over 韩鹏's private writing in /sources (built-in
# openai/text-embedding-3-small embedding). If absent, the chatbot still works,
# just without the extra retrieved context.
UPSTASH_VECTOR_REST_URL=https://xxxx-vector.upstash.io
UPSTASH_VECTOR_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# Canonical URL of THIS site — sitemap, robots, Open Graph, JSON-LD.
# Keep it distinct from the product link in content/profile.json
# → identity.links.website (that one points at 族记).
NEXT_PUBLIC_SITE_URL=https://my.hanpeng.xyz

# Cloudflare Web Analytics beacon token (Dashboard → Analytics & Logs →
# Web Analytics → Manage site). Public by design — safe to expose.
# Unset = beacon not loaded, so localhost stays out of the stats.
NEXT_PUBLIC_CF_BEACON_TOKEN=
