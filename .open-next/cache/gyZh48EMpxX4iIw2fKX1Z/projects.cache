从事 Java 后端与大数据开发，2022 年起在郑州独立开发。从零到一独立交付产品的完整经验，覆盖产品设计、前后端开发、部署运维与 AI 能力集成。目前全职投入族谱 / 家族树应用「族记」（hanpeng.xyz），擅长 Java / TypeScript / React / Next.js / Node.js / PostgreSQL 与大数据组件（Hadoop、Hive、Spark、Kafka），以及把 LLM、RAG、智能体工作流落到真实产品中。\",\"url\":\"https://hanpeng.xyz\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"中国郑州\"},\"email\":\"hanpeng.jack@qq.com\",\"sameAs\":[\"https://hanpeng.xyz\"],\"knowsAbout\":[\"全栈产品开发（从零到一）\",\"Java 后端与高并发系统\",\"大数据平台与数据仓库\",\"AI / LLM 应用落地\",\"RAG 与智能体工作流\",\"Web 架构设计与性能优化\",\"产品设计与用户研究\",\"部署运维与持续交付\"]}</script><script>((a,b,c,d,e,f,g,h)=>{let i=document.documentElement,j=[\"light\",\"dark\"];function k(b){var c;(Array.isArray(a)?a:[a]).forEach(a=>{let c=\"class\"===a,d=c&&f?e.map(a=>f[a]||a):e;c?(i.classList.remove(...d),i.classList.add(f&&f[b]?f[b]:b)):i.setAttribute(a,b)}),c=b,h&&j.includes(c)&&(i.style.colorScheme=c)}if(d)k(d);else try{let a=localStorage.getItem(b)||c,d=g&&\"system\"===a?window.matchMedia(\"(prefers-color-scheme: dark)\").matches?\"dark\":\"light\":a;k(d)}catch(a){}})(\"data-theme\",\"theme\",\"system\",null,[\"light\",\"dark\"],null,true,true)</script><div aria-hidden=\"true\" style=\"pointer-events:none;position:fixed;inset:0;z-index:-1;background:radial-gradient(900px 600px at 82% -8%, color-mix(in srgb, var(--brand) 22%, transparent), transparent 60%),\n            radial-gradient(700px 520px at -6% 18%, color-mix(in srgb, var(--pass) 14%, transparent), transparent 60%),\n            radial-gradient(circle, color-mix(in srgb, var(--text-lo) 28%, transparent) 1px, transparent 1px),\n            var(--bg);background-size:100% 100%, 100% 100%, 28px 28px\"></div><div aria-hidden=\"true\" style=\"pointer-events:none;position:fixed;inset:0;z-index:-1;background:radial-gradient(120% 80% at 50% 0%, transparent 55%, var(--bg) 100%)\"></div><div aria-hidden=\"true\" style=\"pointer-events:none;position:fixed;inset:0;z-index:60;opacity:var(--scan);background-image:repeating-linear-gradient(to bottom, rgba(25